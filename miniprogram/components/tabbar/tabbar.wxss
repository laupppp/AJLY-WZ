.tabbar-wrap {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #eef2f7;
  padding-bottom: env(safe-area-inset-bottom);
}
.tabbar { display: flex; height: 104rpx; padding: 8rpx 8rpx 0; }
.tab {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  color: #94a3b4;
}
.tab.on { color: #183654; }
.tab-icon {
  width: 54rpx; height: 42rpx; line-height: 42rpx;
  text-align: center; font-size: 30rpx;
  border-radius: 12rpx; opacity: 0.62;
}
.tab.on .tab-icon { opacity: 1; background: #eef4fb; }
.tab-label { font-size: 20rpx; margin-top: 4rpx; font-weight: 600; letter-spacing: 0.5rpx; }
