<view class="tabbar-wrap">
  <view class="tabbar">
    <view
      class="tab {{item.key === activeKey ? 'on' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-item="{{item}}"
      bindtap="onTap"
    >
      <view class="tab-icon">{{item.icon}}</view>
      <view class="tab-label">{{item.label}}</view>
    </view>
  </view>
</view>
