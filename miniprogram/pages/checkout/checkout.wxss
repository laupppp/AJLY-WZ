.page { padding-bottom: 200rpx; }

.head {
  background: linear-gradient(140deg, #183654, #2966a5);
  color: #ffffff; padding: 30rpx 32rpx 40rpx; border-radius: 0 0 30rpx 30rpx;
}
.head-title { font-size: 32rpx; font-weight: 700; }
.head-sub { font-size: 22rpx; color: #b9cde2; margin-top: 6rpx; }
.head-amount { font-size: 44rpx; font-weight: 700; margin-top: 14rpx; }

.kv { display: flex; justify-content: space-between; align-items: center; padding: 10rpx 0; font-size: 26rpx; }

.dest {
  background: #ffffff; border: 1rpx solid #e8eef6; border-radius: 22rpx;
  padding: 24rpx; margin: 0 24rpx 20rpx;
}
.dest-head { display: flex; align-items: center; margin-bottom: 16rpx; }
.dest-name { font-size: 28rpx; font-weight: 700; color: #183654; margin-left: 14rpx; flex: 1; }
.dest-remove { font-size: 22rpx; color: #b0413a; }
.alloc-title { font-size: 23rpx; color: #5d7186; margin: 18rpx 0 6rpx; font-weight: 600; }
.alloc { display: flex; align-items: center; padding: 12rpx 0; border-top: 1rpx solid #f1f5fa; }
.dest-actions { display: flex; gap: 16rpx; padding: 0 24rpx 20rpx; }
.dest-actions .btn { flex: 1; }

/* 试算：按费用科目拆分 */
.quote-items { margin-top: 18rpx; border-top: 1rpx dashed #e6edf5; padding-top: 6rpx; }
.quote-item { padding: 14rpx 0; border-bottom: 1rpx solid #f2f6fa; }
.quote-item:last-child { border-bottom: 0; padding-bottom: 0; }
.quote-item-name { font-size: 26rpx; color: #33506f; font-weight: 600; }
.quote-item-amt { font-size: 28rpx; font-weight: 700; color: #183654; }
.qbar { height: 8rpx; border-radius: 8rpx; background: #eef3f9; overflow: hidden; }
.qbar-in { height: 100%; border-radius: 8rpx; background: #2f6ea8; }
.qbar-in.blue { background: #2f6ea8; }
.qbar-in.bad { background: #c0392b; }
