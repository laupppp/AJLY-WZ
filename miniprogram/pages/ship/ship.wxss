.page { padding-bottom: 220rpx; }
.head {
  background: linear-gradient(140deg, #183654, #2966a5);
  color: #fff; padding: 30rpx 32rpx 36rpx; border-radius: 0 0 30rpx 30rpx;
}
.head-title { font-size: 32rpx; font-weight: 700; }
.head-sub { font-size: 22rpx; color: #b9cde2; margin-top: 6rpx; }
.head-meta { font-size: 21rpx; color: #c3d5e6; margin-top: 8rpx; }

/* 配送方式：竖向单选，避免 calc/gap 在部分机型上错位 */
.methods { margin-top: 4rpx; }
.method {
  display: flex; align-items: center;
  border: 1rpx solid #e2eaf4; border-radius: 16rpx;
  padding: 20rpx 22rpx; background: #f9fbfd;
  margin-bottom: 12rpx;
}
.method:last-child { margin-bottom: 0; }
.method.on { border-color: #2966a5; background: #eef5ff; }
.method-main { flex: 1; min-width: 0; }
.method-label { font-size: 27rpx; font-weight: 600; color: #1f3348; }
.method.on .method-label { color: #1c4f83; }
.method-desc { font-size: 20rpx; color: #7d8fa2; margin-top: 4rpx; }
.method-radio {
  width: 40rpx; height: 40rpx; flex-shrink: 0; margin-left: 16rpx;
  border: 2rpx solid #c9d6e4; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; line-height: 1; color: #ffffff;
}
.method.on .method-radio { background: #2966a5; border-color: #2966a5; }

/* 表单区 */
.form { margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx dashed #e8eef6; }
.field { margin-bottom: 22rpx; }
.field.last { margin-bottom: 0; }
.field-label { display: block; font-size: 23rpx; color: #5d7186; margin-bottom: 10rpx; }
.field-label .req { color: #c0392b; margin-left: 4rpx; }
.input, .textarea {
  width: 100%; box-sizing: border-box;
  background: #ffffff; border: 1rpx solid #dde6f0; border-radius: 14rpx;
  padding: 0 22rpx; height: 88rpx; line-height: 88rpx;
  font-size: 28rpx; color: #1f3348;
}
.textarea {
  height: auto; min-height: 150rpx; line-height: 1.6;
  padding: 20rpx 22rpx;
}
.ph-text { color: #a3b1c1; }
.picker-box {
  width: 100%; box-sizing: border-box;
  background: #ffffff; border: 1rpx solid #dde6f0; border-radius: 14rpx;
  padding: 0 22rpx; height: 88rpx; line-height: 88rpx;
  display: flex; align-items: center; justify-content: space-between;
  font-size: 28rpx;
}
.picker-box .picked { color: #1f3348; }
.picker-arrow { color: #9aa9ba; font-size: 24rpx; }
.date-clear { margin-top: 10rpx; font-size: 21rpx; color: #2966a5; }

.filled {
  margin-top: 18rpx; padding: 14rpx 18rpx; border-radius: 12rpx;
  background: #f1f7ff; color: #2b5c8f; font-size: 21rpx; line-height: 1.6;
}

/* 键盘弹起时收起底部栏，避免遮挡输入框 */
.bottom-bar.typing { transform: translateY(120%); transition: transform 0.18s ease; }
