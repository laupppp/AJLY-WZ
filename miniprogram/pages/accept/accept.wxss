.page { padding-bottom: 200rpx; }
.head {
  background: linear-gradient(140deg, #183654, #2966a5);
  color: #fff; padding: 30rpx 32rpx 36rpx; border-radius: 0 0 30rpx 30rpx;
  position: relative;
}
.head-title { font-size: 34rpx; font-weight: 700; }
.head-sub { font-size: 23rpx; color: #c3d5e6; margin-top: 6rpx; }
.head-meta { font-size: 21rpx; color: #c3d5e6; margin-top: 8rpx; }
.back-link { font-size: 22rpx; color: #ffd9a8; margin-top: 14rpx; }

.acc-card {
  background: #fff; border: 1rpx solid #e8eef6; border-radius: 22rpx;
  padding: 24rpx; margin: 20rpx 24rpx; box-shadow: 0 4rpx 16rpx rgba(20, 45, 70, .04);
}
.acc-id { font-size: 28rpx; font-weight: 700; color: #183654; }
.acc-store { font-size: 25rpx; color: #34495f; margin-top: 10rpx; }
.acc-foot { margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx dashed #eef2f8; }
.acc-actions { display: flex; justify-content: flex-end; margin-top: 16rpx; }

.result-row { display: flex; gap: 16rpx; margin-bottom: 8rpx; }
.result {
  flex: 1; border: 1rpx solid #e2eaf4; border-radius: 18rpx; padding: 20rpx;
  background: #f9fbfd;
}
.result.on { border-width: 2rpx; }
.result.on.good { border-color: #1c8a61; background: #ecf9f2; }
.result.on.bad { border-color: #c0392b; background: #fdf0ee; }
.result-title { font-size: 26rpx; font-weight: 700; color: #1f3348; }
.result-desc { font-size: 19rpx; color: #7d8fa2; margin-top: 6rpx; line-height: 1.5; }

.check-row { display: flex; align-items: center; padding: 16rpx 0; border-top: 1rpx solid #f1f5fa; }
.checkbox {
  width: 40rpx; height: 40rpx; border-radius: 10rpx; border: 2rpx solid #c9d7e6;
  margin-right: 16rpx; display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 24rpx; flex-shrink: 0;
}
.checkbox.on { background: #2966a5; border-color: #2966a5; }
.check-text { font-size: 24rpx; color: #34495f; flex: 1; }

.photo-add {
  height: 260rpx; border: 2rpx dashed #c9d7e6; border-radius: 18rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: #f9fbfd;
}
.photo-add-icon { font-size: 54rpx; }
.photo-add-text { font-size: 23rpx; color: #7d8fa2; margin-top: 10rpx; }
.photo-box { position: relative; }
.photo-img { width: 100%; height: 360rpx; border-radius: 18rpx; background: #f1f5fa; }
.photo-del {
  position: absolute; right: 16rpx; bottom: 16rpx;
  background: rgba(16, 33, 51, .62); color: #fff; font-size: 21rpx;
  padding: 8rpx 18rpx; border-radius: 999rpx;
}
