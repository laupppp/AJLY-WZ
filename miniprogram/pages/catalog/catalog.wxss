/* 整页固定高度：顶部信息 + 搜索固定，下面左右分栏各自滚动 */
.page {
  height: 100vh; padding-bottom: 0;
  display: flex; flex-direction: column; overflow: hidden;
}

.ctx-bar {
  flex: 0 0 auto;
  display: flex; align-items: flex-end; justify-content: space-between;
  background: linear-gradient(140deg, #183654, #2966a5);
  padding: 28rpx 32rpx 34rpx; color: #ffffff;
  border-radius: 0 0 30rpx 30rpx;
}
.ctx-label { font-size: 21rpx; color: #b9cde2; }
.ctx-value { font-size: 32rpx; font-weight: 700; margin-top: 6rpx; }
.ctx-value .caret { font-size: 22rpx; color: #a9c3dc; margin-left: 8rpx; }
.ctx-right { text-align: right; }
.ctx-amount { font-size: 34rpx; font-weight: 700; }
.ctx-items { font-size: 21rpx; color: #b9cde2; margin-top: 4rpx; }

.search-wrap { flex: 0 0 auto; padding: 20rpx 24rpx 14rpx; }
.search {
  display: flex; align-items: center; background: #ffffff;
  border: 1rpx solid #e4ebf4; border-radius: 18rpx; padding: 0 22rpx; height: 76rpx;
}
.search-icon { font-size: 26rpx; opacity: 0.5; margin-right: 12rpx; }
.search-input { flex: 1; font-size: 27rpx; }
.search-clear { font-size: 26rpx; color: #9aa9ba; padding: 0 6rpx; }

/* 左右分栏 */
.shop {
  flex: 1 1 0; min-height: 0;
  display: flex; overflow: hidden;
}

/* 左侧竖排目录 */
.rail {
  width: 176rpx; flex: 0 0 176rpx; height: 100%;
  background: #eef3fa; border-right: 1rpx solid #e3eaf3;
  box-sizing: border-box;
}
.rail-item {
  position: relative;
  padding: 20rpx 26rpx 20rpx 18rpx;
  display: flex; flex-direction: column; align-items: flex-start;
}
.rail-label { font-size: 24rpx; color: #52667c; line-height: 1.35; }
.rail-n { font-size: 18rpx; color: #a5b3c2; margin-top: 2rpx; }
.rail-arrow {
  position: absolute; right: 10rpx; top: 24rpx;
  font-size: 18rpx; color: #b5c2d0; line-height: 1;
}
.rail-item.on { background: #ffffff; }
.rail-item.on .rail-label { color: #183654; font-weight: 700; }
.rail-item.on .rail-n { color: #2966a5; }
.rail-item.on .rail-arrow { color: #2966a5; }
.rail-item.on::before {
  content: ''; position: absolute; left: 0; top: 16rpx; bottom: 16rpx;
  width: 6rpx; background: #2966a5; border-radius: 0 6rpx 6rpx 0;
}

.rail-sub {
  position: relative;
  display: flex; align-items: center; justify-content: space-between;
  padding: 14rpx 14rpx 14rpx 30rpx;
  background: #f7fafd; color: #718299;
  border-left: 3rpx solid #e6edf6;
}
.rail-sub-label { font-size: 21rpx; line-height: 1.3; }
.rail-sub-n { font-size: 17rpx; color: #aebccb; }
.rail-sub.on { background: #ffffff; border-left-color: #8fb4dc; }
.rail-sub.on .rail-sub-label { color: #2966a5; font-weight: 700; }
.rail-sub.on .rail-sub-n { color: #2966a5; }
.rail-pad { height: 170rpx; }

/* 右侧商品区 */
.goods { flex: 1 1 0; height: 100%; min-width: 0; }
.goods-inner { padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
.goods-inner.has-bar { padding-bottom: calc(266rpx + env(safe-area-inset-bottom)); }

/* 列表标题：当前二级分类 + 所属大类，避免左栏被塞满全名 */
.list-head {
  display: flex; align-items: flex-end; justify-content: space-between;
  padding: 20rpx 18rpx 12rpx 20rpx;
}
.lh-left { display: flex; flex-direction: column; min-width: 0; }
.list-title {
  font-size: 27rpx; font-weight: 700; color: #183654; line-height: 1.2;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.list-sub { font-size: 19rpx; color: #93a2b4; margin-top: 4rpx; }
.list-count { font-size: 19rpx; color: #96a5b6; flex: 0 0 auto; margin-left: 10rpx; }

/* 常买清单 */
.freq { margin: 8rpx 0 2rpx; }
.freq-head {
  display: flex; align-items: baseline; justify-content: space-between;
  padding: 0 18rpx 10rpx 20rpx;
}
.freq-title { font-size: 23rpx; font-weight: 700; color: #183654; }
.freq-note { font-size: 18rpx; color: #9aa9ba; }
.freq-scroll { white-space: nowrap; padding: 0 10rpx 0 20rpx; }
.freq-card {
  display: inline-block; width: 212rpx; vertical-align: top;
  background: #ffffff; border: 1rpx solid #e8eef6; border-radius: 18rpx;
  padding: 16rpx; margin-right: 12rpx;
}
.freq-name {
  font-size: 22rpx; font-weight: 600; color: #22384f; height: 60rpx;
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box;
  -webkit-line-clamp: 2; -webkit-box-orient: vertical; white-space: normal;
}
.freq-price { font-size: 23rpx; font-weight: 700; color: #2966a5; margin-top: 8rpx; }
.freq-unit { font-size: 18rpx; color: #93a2b4; font-weight: 400; }
.freq-add {
  margin-top: 10rpx; text-align: center; font-size: 19rpx;
  color: #2966a5; background: #eef5ff; border-radius: 10rpx; padding: 8rpx 0;
}
.freq-add.on { background: #e6f6ef; color: #117550; }

.list { padding: 0 16rpx 0 20rpx; }
.prod {
  display: flex; background: #ffffff; border: 1rpx solid #e8eef6;
  border-radius: 18rpx; padding: 20rpx 18rpx; margin-bottom: 14rpx;
}
.prod-ico {
  width: 68rpx; height: 68rpx; border-radius: 18rpx; margin-right: 16rpx;
  background: #f1f6fc; display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; flex-shrink: 0;
}
.prod-name { font-size: 27rpx; font-weight: 700; color: #1f3348; }
.tag-demo {
  font-size: 18rpx; color: #96601a; background: #fff4e2;
  border-radius: 6rpx; padding: 2rpx 8rpx; margin-left: 10rpx; font-weight: 500;
}
.prod-spec {
  font-size: 22rpx; color: #718299; margin-top: 6rpx;
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box;
  -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.prod-sup { font-size: 21rpx; color: #9aa9ba; margin-top: 8rpx; }
.prod-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; }
.prod-price { font-size: 30rpx; font-weight: 700; color: #2966a5; }
.prod-unit { font-size: 20rpx; color: #93a2b4; font-weight: 400; margin-left: 4rpx; }
.btn-step.add { background: #2966a5; color: #ffffff; }

.more {
  text-align: center; padding: 20rpx; margin: 0 16rpx 20rpx 20rpx;
  font-size: 24rpx; color: #2966a5; background: #eef5ff; border-radius: 16rpx;
}

.cart-btn {
  position: relative; width: 92rpx; height: 92rpx; border-radius: 24rpx;
  background: #eef5ff; display: flex; align-items: center; justify-content: center;
}
.cart-ico { font-size: 40rpx; }
.cart-badge {
  position: absolute; top: -8rpx; right: -8rpx;
  min-width: 34rpx; height: 34rpx; padding: 0 8rpx; border-radius: 999rpx;
  background: #d64541; color: #fff; font-size: 20rpx; line-height: 34rpx; text-align: center;
}

.mask { position: fixed; inset: 0; background: rgba(16, 33, 51, 0.42); z-index: 50; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
  background: #ffffff; border-radius: 32rpx 32rpx 0 0;
  max-height: 78vh; display: flex; flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}
.sheet-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 26rpx 28rpx 16rpx; border-bottom: 1rpx solid #eef2f8;
}
.sheet-clear { font-size: 24rpx; color: #c0392b; }
.sheet-body { padding: 0 28rpx; max-height: 52vh; }
.sheet-foot {
  display: flex; gap: 16rpx; padding: 20rpx 28rpx 26rpx; border-top: 1rpx solid #eef2f8;
}
.sheet-foot .btn { flex: 1; }

/* 左侧目录：可再次点击收起，文字单行省略，展开/收起的层级更清楚 */
.rail-label {
  width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.rail-n { line-height: 1.2; }
.rail-sub { padding-top: 12rpx; padding-bottom: 12rpx; }
.rail-sub-label {
  max-width: 96rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.rail-fold {
  display: flex; align-items: center; justify-content: center;
  padding: 10rpx 0 14rpx;
  font-size: 19rpx; color: #93a4b8; background: #f7fafd;
  border-left: 3rpx solid #e6edf6;
  letter-spacing: 1rpx;
}
.rail-fold:active { color: #2966a5; background: #eef4fb; }
