.page { padding-bottom: 60rpx; }

.hero {
  background: linear-gradient(140deg, #183654, #2966a5);
  color: #fff; padding: 30rpx 32rpx 32rpx; border-radius: 0 0 30rpx 30rpx;
}
.hero-title { font-size: 34rpx; font-weight: 700; }
.hero-sub { font-size: 23rpx; color: #bcd2e8; margin-top: 8rpx; line-height: 1.5; }
.hero-foot {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(255, 255, 255, .16);
  font-size: 22rpx; color: #cfdeee;
}

.search { padding: 20rpx 24rpx 4rpx; }
.search-input {
  height: 78rpx; background: #fff; border: 1rpx solid #e6edf5; border-radius: 18rpx;
  padding: 0 24rpx; font-size: 26rpx;
}

.card {
  background: #fff; border: 1rpx solid #e8eef6; border-radius: 22rpx;
  margin: 16rpx 24rpx 0; padding: 22rpx 24rpx 18rpx;
}
.row { display: flex; align-items: center; }
.flex1 { flex: 1; min-width: 0; }
.store-name { font-size: 29rpx; font-weight: 700; color: #183654; }
.store-sub { font-size: 22rpx; color: #6b7f94; margin-top: 6rpx; }
.store-go { font-size: 23rpx; color: #2f6ea8; padding-left: 16rpx; }

.items { margin-top: 14rpx; padding-top: 12rpx; border-top: 1rpx dashed #eef3f9; }
.item-line { display: flex; align-items: center; padding: 6rpx 0; }
.item-name { font-size: 24rpx; color: #33506f; width: 150rpx; }
.item-basis { font-size: 21rpx; color: #8fa3b8; flex: 1; }
.item-amt { font-size: 25rpx; font-weight: 600; color: #183654; }

.editor { margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid #eef3f9; }
.field { margin-bottom: 16rpx; }
.field-label { font-size: 22rpx; color: #5d7186; margin-bottom: 8rpx; display: block; }
.input {
  height: 76rpx; background: #f8fbfe; border: 1rpx solid #e2ebf5; border-radius: 16rpx;
  padding: 0 20rpx; font-size: 26rpx;
}
.edit-item { padding: 14rpx 0; border-bottom: 1rpx dashed #f0f5fa; }
.edit-item:last-of-type { border-bottom: 0; }
.edit-item-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10rpx; }
.edit-item-head text:first-child { font-size: 25rpx; font-weight: 600; color: #33506f; }
.edit-item-amt { font-size: 22rpx; color: #6b7f94; }
.edit-item-adj { color: #b07a1e; }
.edit-row { display: flex; gap: 14rpx; }
.edit-cell { flex: 1; min-width: 0; }
.edit-label { font-size: 20rpx; color: #8fa3b8; display: block; margin-bottom: 6rpx; }
.input.sm { height: 68rpx; font-size: 24rpx; }

.edit-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.edit-actions .btn { flex: 1; }
.edit-note { font-size: 20rpx; color: #8fa3b8; line-height: 1.6; margin-top: 14rpx; }

.more {
  margin: 22rpx 24rpx 0; height: 76rpx; line-height: 76rpx; text-align: center;
  background: #fff; border: 1rpx dashed #d7e3f0; border-radius: 18rpx;
  color: #5d7186; font-size: 24rpx;
}
.foot-note {
  margin: 26rpx 30rpx 0; font-size: 20rpx; color: #8fa3b8; line-height: 1.7;
}
